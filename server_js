  console.log(`\n🚀 Discord Bot Panel démarré sur http://localhost:${PORT}`);
  console.log(`📦 Base de données: botpanel.db`);
  console.log(`🔑 Créez votre compte sur http://localhost:${PORT}\n`);
});
