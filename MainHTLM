<!-- ─ SCRIPTS ─────────────────────────────────────────────── -->
<script>
let currentUser = null;
let currentBotId = null;
let activeBotTab = 'overview';
let logRefreshInterval = null;

// ─ UTILS ─────────────────────────────────────────────────────────────────────
function toast(msg, type = 'info') {
  const el = document.createElement('div');
  el.className = `toast toast-${type}`;
  el.textContent = msg;
  document.getElementById('toastContainer').appendChild(el);
  setTimeout(() => el.remove(), 3500);
}

function showError(msg) {
  const el = document.getElementById('authError');
  el.textContent = msg;
  el.style.display = 'block';
}

function hideError() {
  document.getElementById('authError').style.display = 'none';
}

async function api(method, path, body) {
  const opts = { method, headers: { 'Content-Type': 'application/json' }, credentials: 'include' };
  if (body) opts.body = JSON.stringify(body);
  const res = await fetch(path, opts);
  return res.json();
}

function formatUptime(sec) {
  if (!sec) return '—';
  const h = Math.floor(sec / 3600);
  const m = Math.floor((sec % 3600) / 60);
  const s = sec % 60;
  if (h > 0) return `${h}h ${m}m`;
  if (m > 0) return `${m}m ${s}s`;
  return `${s}s`;
}

function formatDate(dt) {
  if (!dt) return '—';
  return new Date(dt).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' });
}

function getStatusBadge(status) {
  const map = {
    online: '<span class="badge badge-online"><span class="status-dot dot-online"></span>En ligne</span>',
    offline: '<span class="badge badge-offline"><span class="status-dot dot-offline"></span>Hors ligne</span>',
    error: '<span class="badge badge-error"><span class="status-dot dot-error"></span>Erreur</span>',
  };
  return map[status] || map.offline;
}

// ─ AUTH ───────────────────────────────────────────────────────────────────────
function switchAuthTab(tab) {
  hideError();
  document.querySelectorAll('.auth-tab').forEach((el, i) => el.classList.toggle('active', (i === 0) === (tab === 'login')));
  document.getElementById('loginForm').style.display = tab === 'login' ? 'block' : 'none';
  document.getElementById('registerForm').style.display = tab === 'register' ? 'block' : 'none';
}

async function login() {
  hideError();
  const username = document.getElementById('loginUser').value.trim();
  const password = document.getElementById('loginPass').value;
  if (!username || !password) return showError('Veuillez remplir tous les champs');
  const data = await api('POST', '/api/auth/login', { username, password });
  if (data.error) return showError(data.error);
  currentUser = data.user;
  launchApp();
}

async function register() {
  hideError();
  const username = document.getElementById('regUser').value.trim();
  const email = document.getElementById('regEmail').value.trim();
  const password = document.getElementById('regPass').value;
  if (!username || !email || !password) return showError('Veuillez remplir tous les champs');
  const data = await api('POST', '/api/auth/register', { username, email, password });
  if (data.error) return showError(data.error);
  currentUser = data.user;
  toast('Compte créé avec succès ! Bienvenue 🎉', 'success');
  launchApp();
}

async function logout() {
  await api('POST', '/api/auth/logout');
  currentUser = null;
  document.getElementById('appScreen').style.display = 'none';
  document.getElementById('authScreen').style.display = 'flex';
  if (logRefreshInterval) clearInterval(logRefreshInterval);
}

function loginWithDiscord() {
  window.location.href = '/auth/discord';
}

async function checkSession() {
  // Vérifie si erreur OAuth Discord dans l'URL
  const params = new URLSearchParams(window.location.search);
  const discordError = params.get('discord_error');
  if (discordError) {
    const msgs = {
      access_denied: 'Connexion Discord annulée.',
      token_failed: 'Échec de la connexion Discord. Vérifie ton Client ID/Secret.',
      user_failed: 'Impossible de récupérer ton profil Discord.',
      server_error: 'Erreur serveur lors de la connexion Discord.',
    };
    showError(msgs[discordError] || 'Erreur Discord inconnue.');
    window.history.replaceState({}, '', '/');
  }
  try {
    const data = await api('GET', '/api/auth/me');
    if (data && data.id) { currentUser = data; launchApp(); }
  } catch(e) {}
}

function launchApp() {
  document.getElementById('authScreen').style.display = 'none';
  document.getElementById('appScreen').style.display = 'block';
  document.getElementById('userNameDisplay').textContent = currentUser.discord_tag || currentUser.username;

  const avatarEl = document.getElementById('userAvatar');
  if (currentUser.discord_avatar) {
    avatarEl.innerHTML = `<img src="${currentUser.discord_avatar}" alt="avatar">`;
    avatarEl.style.background = 'transparent';
  } else {
    avatarEl.textContent = (currentUser.username || '?')[0].toUpperCase();
  }

  // Badge Discord dans la sidebar si connecté via Discord
  if (currentUser.auth_type === 'discord') {
    document.getElementById('userAuthBadge').innerHTML = '<span class="discord-badge">⚡ Discord</span>';
  }

  loadDashboard();
  showPage('dashboard');
}

// ─ NAVIGATION ─────────────────────────────────────────────────────────────────
function showPage(page, botId) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.getElementById(`page-${page}`)?.classList.add('active');
  document.getElementById(`nav-${page}`)?.classList.add('active');

  if (logRefreshInterval) { clearInterval(logRefreshInterval); logRefreshInterval = null; }

  if (page === 'dashboard') loadDashboard();
  if (page === 'bots') loadBotsList();
  if (page === 'bot-detail' && botId) {
    currentBotId = botId;
    loadBotDetail(botId);
  }
}

function switchBotTab(tab) {
  activeBotTab = tab;
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  document.querySelector(`.tab[onclick="switchBotTab('${tab}')"]`).classList.add('active');
  document.getElementById(`tab-${tab}`).classList.add('active');

  if (tab === 'logs') { loadLogs(); logRefreshInterval = setInterval(loadLogs, 5000); }
  else if (logRefreshInterval) { clearInterval(logRefreshInterval); logRefreshInterval = null; }

  if (tab === 'commands') loadCommands();
  if (tab === 'overview') loadBotOverview();
  if (tab === 'settings') loadBotSettings();
}

// ─ DASHBOARD ─────────────────────────────────────────────────────────────────
async function loadDashboard() {
  const bots = await api('GET', '/api/bots');
  if (!Array.isArray(bots)) return;

  document.getElementById('statTotal').textContent = bots.length;
  document.getElementById('statOnline').textContent = bots.filter(b => b.status === 'online').length;

  let totalCmds = 0, totalGuilds = 0;

  document.getElementById('dashBotsList').innerHTML = '';

  if (bots.length === 0) {
    document.getElementById('dashBotsList').innerHTML = `
      <div class="empty-state" style="grid-column:1/-1">
        <div class="emoji">🤖</div>
        <h3>Aucun bot configuré</h3>
        <p>Ajoutez votre premier bot Discord pour commencer</p>
        <button class="btn btn-primary" onclick="openAddBotModal()">+ Ajouter un bot</button>
      </div>`;
  }

  for (const bot of bots) {
    const stats = await api('GET', `/api/bots/${bot.id}/stats`);
    if (stats) { totalCmds += stats.commands || 0; totalGuilds += stats.guilds || 0; }
    renderBotCard(bot, stats, 'dashBotsList');
  }

  document.getElementById('statCmds').textContent = totalCmds;
  document.getElementById('statGuilds').textContent = totalGuilds;
  updateSidebarBots(bots);
}

// ─ BOTS LIST ──────────────────────────────────────────────────────────────────
async function loadBotsList() {
  const bots = await api('GET', '/api/bots');
  document.getElementById('botsListPage').innerHTML = '';
  if (!Array.isArray(bots) || bots.length === 0) {
    document.getElementById('botsListPage').innerHTML = `
      <div class="empty-state" style="grid-column:1/-1">
        <div class="emoji">🤖</div>
        <h3>Aucun bot configuré</h3>
        <p>Créez votre premier bot Discord</p>
        <button class="btn btn-primary" onclick="openAddBotModal()">+ Ajouter un bot</button>
      </div>`;
    return;
  }
  for (const bot of bots) {
    const stats = await api('GET', `/api/bots/${bot.id}/stats`).catch(() => null);
    renderBotCard(bot, stats, 'botsListPage');
  }
}

function renderBotCard(bot, stats, containerId) {
  const div = document.createElement('div');
  div.className = 'bot-card';
  div.innerHTML = `
    <div class="bot-card-header">
      <div class="bot-avatar">🤖</div>
      <div>
        <div class="bot-name">${bot.name}</div>
        <div class="bot-meta">${getStatusBadge(bot.status)} <span>Préfixe: <b>${bot.prefix}</b></span></div>
      </div>
    </div>
    <div class="bot-desc">${bot.description || '<em>Aucune description</em>'}</div>
    <div class="bot-card-footer">
      <button class="btn btn-ghost btn-sm" onclick="event.stopPropagation();showPage('bot-detail',${bot.id})">⚙️ Gérer</button>
      ${bot.status === 'online'
        ? `<button class="btn btn-danger btn-sm" onclick="event.stopPropagation();botAction(${bot.id},'stop')">⏹ Arrêter</button>`
        : `<button class="btn btn-success btn-sm" onclick="event.stopPropagation();botAction(${bot.id},'start')">▶ Démarrer</button>`}
      ${stats ? `<span style="margin-left:auto;font-size:12px;color:var(--text2)">📡 ${stats.guilds} serveur(s) · 📋 ${stats.commands} cmd(s)</span>` : ''}
    </div>
  `;
  div.onclick = () => showPage('bot-detail', bot.id);
  document.getElementById(containerId).appendChild(div);
}

function updateSidebarBots(bots) {
  document.getElementById('sidebarBotList').innerHTML = bots.map(b => `
    <div class="nav-item bot-nav-item" onclick="showPage('bot-detail',${b.id})">
      <span class="status-dot ${b.status === 'online' ? 'dot-online' : 'dot-offline'}"></span>
      ${b.name}
    </div>
  `).join('');
}

// ─ BOT DETAIL ─────────────────────────────────────────────────────────────────
async function loadBotDetail(botId) {
  const bots = await api('GET', '/api/bots');
  const bot = bots.find(b => b.id === botId);
  if (!bot) return;

  const stats = await api('GET', `/api/bots/${botId}/stats`);

  document.getElementById('botDetailHeader').innerHTML = `
    <div class="bot-detail-avatar">🤖</div>
    <div class="bot-detail-info">
      <h2>${bot.name}</h2>
      <p>${bot.description || 'Aucune description'} · Préfixe: <b>${bot.prefix}</b></p>
    </div>
    <div class="bot-detail-actions">
      ${getStatusBadge(bot.status)}
      ${bot.status === 'online'
        ? `<button class="btn btn-danger btn-sm" onclick="botAction(${botId},'stop')">⏹ Arrêter</button>
           <button class="btn btn-ghost btn-sm" onclick="botAction(${botId},'restart')">🔄 Redémarrer</button>`
        : `<button class="btn btn-success btn-sm" onclick="botAction(${botId},'start')">▶ Démarrer</button>`
      }
    </div>
  `;

  activeBotTab = 'overview';
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  document.querySelector('.tab').classList.add('active');
  document.getElementById('tab-overview').classList.add('active');
  loadBotOverview(bot, stats);
}

async function loadBotOverview(bot, stats) {
  if (!bot) {
    const bots = await api('GET', '/api/bots');
    bot = bots.find(b => b.id === currentBotId);
    stats = await api('GET', `/api/bots/${currentBotId}/stats`);
  }
  document.getElementById('tab-overview').innerHTML = `
    <div class="stats-grid" style="grid-template-columns:repeat(3,1fr)">
      <div class="stat-card"><div class="stat-label">Commandes</div><div class="stat-value accent">${stats?.commands || 0}</div></div>
      <div class="stat-card"><div class="stat-label">Serveurs Discord</div><div class="stat-value green">${stats?.guilds || 0}</div></div>
      <div class="stat-card"><div class="stat-label">Uptime</div><div class="stat-value">${formatUptime(stats?.uptime)}</div></div>
    </div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;margin-top:16px">
      <h3 style="margin-bottom:16px;font-size:14px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.8px">Informations</h3>
      <table width="100%">
        <tr><td style="color:var(--text2);padding:8px 0;width:180px">Statut</td><td>${getStatusBadge(bot?.status)}</td></tr>
        <tr><td style="color:var(--text2);padding:8px 0">Démarré le</td><td>${formatDate(bot?.last_started)}</td></tr>
        <tr><td style="color:var(--text2);padding:8px 0">Créé le</td><td>${formatDate(bot?.created_at)}</td></tr>
        <tr><td style="color:var(--text2);padding:8px 0">Préfixe</td><td><span class="cmd-name">${bot?.prefix}</span></td></tr>
        <tr><td style="color:var(--text2);padding:8px 0">Redémarrage auto</td><td>${bot?.auto_restart ? '✅ Activé' : '❌ Désactivé'}</td></tr>
        <tr><td style="color:var(--text2);padding:8px 0">Total commandes utilisées</td><td>${stats?.totalUsage || 0}</td></tr>
      </table>
    </div>
  `;
}

async function loadCommands() {
  const cmds = await api('GET', `/api/bots/${currentBotId}/commands`);
  const bots = await api('GET', '/api/bots');
  const bot = bots.find(b => b.id === currentBotId);
  const prefix = bot?.prefix || '!';

  let html = `
    <div class="section-header">
      <h3>Commandes (${cmds.length})</h3>
      <button class="btn btn-primary btn-sm" onclick="openAddCmdModal()">+ Nouvelle commande</button>
    </div>
  `;

  if (!cmds.length) {
    html += `<div class="empty-state"><div class="emoji">📋</div><h3>Aucune commande</h3><p>Créez votre première commande personnalisée</p><button class="btn btn-primary btn-sm" onclick="openAddCmdModal()">+ Créer une commande</button></div>`;
  } else {
    html += `<div class="table-wrap"><table>
      <thead><tr><th>Commande</th><th>Réponse</th><th>Utilisations</th><th>Statut</th><th>Actions</th></tr></thead>
      <tbody>`;
    for (const cmd of cmds) {
      html += `<tr>
        <td><span class="cmd-name">${prefix}${cmd.name}</span></td>
        <td style="color:var(--text2);max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${cmd.response}</td>
        <td>${cmd.usage_count}</td>
        <td><button class="toggle ${cmd.enabled ? 'on' : ''}" onclick="toggleCmd(${cmd.id},${cmd.enabled ? 0 : 1},'${cmd.name}','${cmd.response.replace(/'/g,"\\'")}')"></button></td>
        <td><button class="btn btn-danger btn-sm" onclick="deleteCmd(${cmd.id})">🗑</button></td>
      </tr>`;
    }
    html += `</tbody></table></div>`;
  }
  document.getElementById('tab-commands').innerHTML = html;
}

async function loadLogs() {
  const logs = await api('GET', `/api/bots/${currentBotId}/logs?limit=100`);
  if (!Array.isArray(logs)) return;
  const container = document.getElementById('tab-logs');
  if (!container.querySelector('.logs-container')) {
    container.innerHTML = `
      <div class="section-header">
        <h3>Logs en temps réel</h3>
        <button class="btn btn-ghost btn-sm" onclick="clearLogs()">🗑 Vider les logs</button>
      </div>
      <div class="logs-container" id="logsBox"></div>
    `;
  }
  const box = document.getElementById('logsBox');
  const wasBottom = box.scrollHeight - box.clientHeight <= box.scrollTop + 30;
  box.innerHTML = logs.length === 0
    ? '<div style="text-align:center;padding:40px;color:var(--text3)">Aucun log disponible</div>'
    : logs.map(l => `
        <div class="log-entry log-${l.level}">
          <span class="log-time">${formatDate(l.created_at)}</span>
          <span class="log-msg">${l.message}</span>
        </div>`).join('');
  if (wasBottom) box.scrollTop = box.scrollHeight;
}

async function loadBotSettings() {
  const bots = await api('GET', '/api/bots');
  const bot = bots.find(b => b.id === currentBotId);
  document.getElementById('tab-settings').innerHTML = `
    <div style="max-width:560px">
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:24px;margin-bottom:20px">
        <h3 style="margin-bottom:20px">⚙️ Paramètres du bot</h3>
        <div class="form-group"><label>Nom du bot</label><input type="text" id="editBotName" value="${bot?.name || ''}"></div>
        <div class="form-group"><label>Préfixe</label><input type="text" id="editBotPrefix" value="${bot?.prefix || '!'}" maxlength="5"></div>
        <div class="form-group"><label>Description</label><textarea id="editBotDesc">${bot?.description || ''}</textarea></div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0">
          <div>
            <div style="font-weight:600;font-size:14px">Redémarrage automatique</div>
            <div style="font-size:12px;color:var(--text2);margin-top:2px">Redémarre le bot en cas d'erreur</div>
          </div>
          <button class="toggle ${bot?.auto_restart ? 'on' : ''}" id="editAutoRestart" onclick="this.classList.toggle('on')"></button>
        </div>
        <button class="btn btn-primary" onclick="saveSettings()">💾 Sauvegarder</button>
      </div>
      <div style="background:rgba(237,66,69,0.08);border:1px solid rgba(237,66,69,0.2);border-radius:var(--radius);padding:24px">
        <h3 style="margin-bottom:12px;color:var(--red)">⚠️ Zone dangereuse</h3>
        <p style="font-size:13px;color:var(--text2);margin-bottom:16px">La suppression d'un bot est irréversible. Toutes les commandes et logs seront perdus.</p>
        <button class="btn btn-danger" onclick="deleteBot()">🗑 Supprimer ce bot</button>
      </div>
    </div>
  `;
}

// ─ ACTIONS ───────────────────────────────────────────────────────────────────
async function botAction(botId, action) {
  const labels = { start: 'Démarrage...', stop: 'Arrêt...', restart: 'Redémarrage...' };
  toast(labels[action], 'info');
  const data = await api('POST', `/api/bots/${botId}/${action}`);
  if (data.success) {
    toast(action === 'start' ? '✅ Bot démarré !' : action === 'stop' ? '🛑 Bot arrêté' : '🔄 Bot redémarré', 'success');
  } else {
    toast(`❌ ${data.error}`, 'error');
  }
  // Refresh current view
  if (currentBotId === botId) loadBotDetail(botId);
  else loadDashboard();
}

async function clearLogs() {
  await api('DELETE', `/api/bots/${currentBotId}/logs`);
  loadLogs();
  toast('Logs vidés', 'info');
}

async function deleteBot() {
  if (!confirm(`Supprimer ce bot ? Cette action est irréversible.`)) return;
  const data = await api('DELETE', `/api/bots/${currentBotId}`);
  if (data.success) { toast('Bot supprimé', 'info'); showPage('bots'); }
}

async function saveSettings() {
  const name = document.getElementById('editBotName').value;
  const prefix = document.getElementById('editBotPrefix').value;
  const description = document.getElementById('editBotDesc').value;
  const auto_restart = document.getElementById('editAutoRestart').classList.contains('on');
  await api('PUT', `/api/bots/${currentBotId}`, { name, prefix, description, auto_restart });
  toast('✅ Paramètres sauvegardés', 'success');
  loadBotDetail(currentBotId);
}

async function toggleCmd(id, enabled, name, response) {
  await api('PUT', `/api/bots/${currentBotId}/commands/${id}`, { name, response, enabled });
  loadCommands();
}

async function deleteCmd(id) {
  if (!confirm('Supprimer cette commande ?')) return;
  await api('DELETE', `/api/bots/${currentBotId}/commands/${id}`);
  toast('Commande supprimée', 'info');
  loadCommands();
}

// ─ MODALS ─────────────────────────────────────────────────────────────────────
function openAddBotModal() { document.getElementById('addBotModal').classList.add('open'); }
function openAddCmdModal() { document.getElementById('addCmdModal').classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

document.querySelectorAll('.modal-overlay').forEach(overlay => {
  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('open'); });
});

async function addBot() {
  const name = document.getElementById('newBotName').value.trim();
  const token = document.getElementById('newBotToken').value.trim();
  const client_id = document.getElementById('newBotClientId').value.trim();
  const prefix = document.getElementById('newBotPrefix').value.trim() || '!';
  const description = document.getElementById('newBotDesc').value.trim();

  if (!name || !token) return toast('Nom et token requis', 'error');
  const data = await api('POST', '/api/bots', { name, token, client_id, prefix, description });
  if (data.error) return toast(`❌ ${data.error}`, 'error');

  closeModal('addBotModal');
  toast('🤖 Bot ajouté avec succès !', 'success');
  ['newBotName','newBotToken','newBotClientId','newBotDesc'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('newBotPrefix').value = '!';
  loadDashboard();
}

async function addCommand() {
  const name = document.getElementById('newCmdName').value.trim();
  const response = document.getElementById('newCmdResponse').value.trim();
  if (!name || !response) return toast('Nom et réponse requis', 'error');

  const data = await api('POST', `/api/bots/${currentBotId}/commands`, { name, response });
  if (data.error) return toast(`❌ ${data.error}`, 'error');

  closeModal('addCmdModal');
  toast('✅ Commande ajoutée', 'success');
  document.getElementById('newCmdName').value = '';
  document.getElementById('newCmdResponse').value = '';
  loadCommands();
}

// ─ KEYBOARD ──────────────────────────────────────────────────────────────────
document.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') {
    if (document.getElementById('loginForm').style.display !== 'none') login();
    else if (document.getElementById('registerForm').style.display !== 'none') register();
  }
  if (e.key === 'Escape') {
    document.querySelectorAll('.modal-overlay.open').forEach(m => m.classList.remove('open'));
  }
});

// ─ INIT ──────────────────────────────────────────────────────────────────────
checkSession();
</script>
</body>
</html>
